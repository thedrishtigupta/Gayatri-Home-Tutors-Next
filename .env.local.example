# ── Database ─────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=gayatri_home_tutors

# Managed hosts (Aiven, PlanetScale, DigitalOcean…) require TLS and sign their
# certificates with a private CA, so the provider's ca.pem must be supplied.
# The certificate is public, not a secret. Use ONE of:
#   DB_SSL_CA_PATH  path to the file, relative to the project root
#   DB_SSL_CA       the PEM inline; literal \n escapes are accepted, which is
#                   what Vercel and most dashboards need
#   DB_SSL=true     require TLS against a publicly trusted CA (no file needed)
# Leave all three unset for a plain local MySQL.
#
# Aiven example — download ca.pem from the service overview page:
#   DB_HOST=mysql-xxxxxxx-yyyyyyy.a.aivencloud.com
#   DB_PORT=12345          (Aiven assigns a random port, never 3306)
#   DB_USER=avnadmin
#   DB_NAME=defaultdb
#   DB_SSL_CA_PATH=database/ca.pem
# DB_SSL_CA_PATH=database/ca.pem

# Connection pool size. Managed free tiers cap max_connections low; raise this
# only if you know the server's limit. Defaults to 5.
# DB_POOL_SIZE=5

# ── Auth ──────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=replace-this-with-a-long-random-string

# ── Email (tutor panel verification & password resets) ───────────
# Any SMTP provider works — nothing in the code is Gmail-specific.
#
# Gmail: enable 2FA on the account, then create an App Password at
#   https://myaccount.google.com/apppasswords   (16 characters, no spaces)
# Personal Gmail is capped at 500 recipients/day. Google Workspace accounts
# CANNOT use App Passwords — they require OAuth 2.0, so use a provider like
# Resend or Brevo instead if you are on Workspace.
#
# Leave these unset and email sending is disabled: tutor signups then go to
# the admin approval queue instead, so nobody is blocked.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM="Gayatri Home Tutors <you@gmail.com>"

# ── Telegram ─────────────────────────────────────────────────────
# Create a bot via @BotFather, add it as admin to your channel
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHANNEL_ID=@your_channel_or_-100xxxxxxxxxx

# ── Site ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://gayatrihometutors.com
NEXT_PUBLIC_PHONE=+918505952700
